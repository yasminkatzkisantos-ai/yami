:root {
  --bg-main: #0f172a;
  --bg-card: #1e293b;
  --bg-card-hover: #334155;
  --primary: #38bdf8;
  --primary-hover: #0284c7;
  --accent: #818cf8;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --border-color: #334155;
  --radius: 12px;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-main);
  color: var(--text-main);
  line-height: 1.6;
}

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
  z-index: 1000;
  padding: 15px 0;
}

.nav-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--primary);
  text-decoration: none;
}

.nav-links {
  display: flex;
  gap: 20px;
}

.nav-item {
  color: var(--text-muted);
  text-decoration: none;
  font-weight: 500;
  font-size: 0.95rem;
  transition: all 0.2s ease;
  padding: 6px 12px;
  border-radius: 6px;
}

.nav-item:hover, .nav-item.active {
  color: var(--text-main);
  background-color: rgba(255, 255, 255, 0.05);
}

.hero-section {
  padding: 140px 20px 80px 20px;
  background: radial-gradient(circle at top center, rgba(56, 189, 248, 0.15), transparent 60%);
  text-align: center;
}

.hero-content {
  max-width: 800px;
  margin: 0 auto;
}

.badge {
  display: inline-block;
  background: rgba(56, 189, 248, 0.1);
  color: var(--primary);
  border: 1px solid rgba(56, 189, 248, 0.3);
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 20px;
}

.hero-section h1 {
  font-size: 2.8rem;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 15px;
}

.highlight {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  color: var(--text-muted);
  font-size: 1.15rem;
  margin-bottom: 30px;
}

.hero-buttons {
  display: flex;
  justify-content: center;
  gap: 15px;
  margin-bottom: 50px;
}

.btn {
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-primary {
  background-color: var(--primary);
  color: #0f172a;
}

.btn-primary:hover {
  background-color: var(--primary-hover);
}

.btn-secondary {
  background-color: transparent;
  color: var(--text-main);
  border: 1px solid var(--border-color);
}

.btn-secondary:hover {
  background-color: var(--bg-card);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 20px;
}

.stat-number {
  display: block;
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--primary);
}

.stat-label {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.main-content {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px 80px 20px;
}

.section {
  padding-top: 80px;
}

.section-header {
  margin-bottom: 40px;
}

.section-header h2 {
  font-size: 1.8rem;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 10px;
}

.section-desc {
  color: var(--text-muted);
  font-size: 0.95rem;
  margin-top: 5px;
}

.about-grid {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 30px;
}

.about-avatar-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 30px;
  text-align: center;
}

.avatar-container {
  width: 130px;
  height: 130px;
  margin: 0 auto 15px auto;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid var(--primary);
  box-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-card);
}

.avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.tag-title {
  color: var(--primary);
  font-size: 0.85rem;
  margin-top: 4px;
  margin-bottom: 20px;
}

.quick-contacts {
  border-top: 1px solid var(--border-color);
  padding-top: 15px;
  font-size: 0.85rem;
  text-align: left;
}

.quick-contacts p {
  margin-bottom: 10px;
  color: var(--text-muted);
  line-height: 1.4;
}

.quick-contacts a {
  color: var(--primary);
  text-decoration: none;
}

.about-text-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 30px;
}

.about-text-card h3 {
  font-size: 1.4rem;
  margin-bottom: 15px;
  color: var(--primary);
}

.about-text-card p {
  color: #cbd5e1;
  margin-bottom: 15px;
  font-size: 0.95rem;
}

.about-highlights {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid var(--border-color);
}

.highlight-item {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.highlight-item i {
  font-size: 1.3rem;
  color: var(--primary);
  margin-top: 3px;
}

.highlight-item h4 {
  font-size: 0.95rem;
}

.highlight-item p {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-bottom: 0;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 20px;
}

.skill-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 20px;
  text-align: center;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.skill-card:hover {
  transform: translateY(-5px);
  border-color: var(--primary);
}

.skill-icon {
  font-size: 2.2rem;
  margin-bottom: 10px;
}

.html-color { color: #e34f26; }
.css-color { color: #1572b6; }
.js-color { color: #f7df1e; }
.firebase-color { color: #ffca28; }
.git-color { color: #f05032; }
.responsive-color { color: #38bdf8; }

.skill-card h4 {
  font-size: 1rem;
  margin-bottom: 5px;
}

.skill-card p {
  font-size: 0.8rem;
  color: var(--text-muted);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 25px;
}

.project-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}

.project-card:hover {
  transform: translateY(-5px);
}

.project-header {
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calc-bg { background: linear-gradient(135deg, #1e3a8a, #3b82f6); }
.barber-bg { background: linear-gradient(135deg, #0f172a, #334155); }
.firebase-bg { background: linear-gradient(135deg, #78350f, #d97706); }

.project-icon {
  font-size: 3rem;
  color: rgba(255, 255, 255, 0.8);
}

.project-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.project-tag {
  font-size: 0.75rem;
  color: var(--primary);
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.project-body h3 {
  font-size: 1.2rem;
  margin-bottom: 8px;
}

.project-body p {
  font-size: 0.88rem;
  color: var(--text-muted);
  margin-bottom: 20px;
  flex: 1;
}

.btn-project {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: rgba(56, 189, 248, 0.1);
  color: var(--primary);
  text-decoration: none;
  padding: 10px;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  transition: background 0.2s ease;
}

.btn-project:hover {
  background-color: var(--primary);
  color: #0f172a;
}

.activities-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 30px;
}

.activity-info h3 {
  color: var(--primary);
  margin-bottom: 10px;
}

.activity-info p {
  color: var(--text-muted);
  font-size: 0.95rem;
  margin-bottom: 25px;
}

.activities-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.act-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background-color: rgba(255, 255, 255, 0.02);
  padding: 12px 16px;
  border-radius: 8px;
  border-left: 3px solid var(--primary);
}

.act-icon {
  color: var(--primary);
  margin-top: 4px;
}

.act-item strong {
  display: block;
  font-size: 0.95rem;
}

.act-item span {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.contact-card {
  background: linear-gradient(135deg, #1e293b, #0f172a);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 40px;
  text-align: center;
}

.contact-card h3 {
  font-size: 1.5rem;
  margin-bottom: 5px;
}

.contact-card p {
  color: var(--text-muted);
  margin-bottom: 30px;
}

.contact-links-grid {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.contact-link-box {
  display: flex;
  align-items: center;
  gap: 10px;
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 12px 20px;
  border-radius: 8px;
  color: var(--text-main);
  text-decoration: none;
  font-weight: 600;
  transition: border-color 0.2s ease;
}

.contact-link-box i {
  color: var(--primary);
  font-size: 1.2rem;
}

.contact-link-box:hover {
  border-color: var(--primary);
}

.footer {
  border-top: 1px solid var(--border-color);
  padding: 30px 20px;
  text-align: center;
  color: var(--text-muted);
  font-size: 0.85rem;
}

.footer-sub {
  margin-top: 5px;
  font-size: 0.75rem;
}

@media (max-width: 768px) {
  .about-grid {
    grid-template-columns: 1fr;
  }

  .nav-links {
    display: none;
  }

  .hero-section h1 {
    font-size: 2rem;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .about-highlights {
    grid-template-columns: 1fr;
  }
}