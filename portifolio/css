/* =====================================================
   RESET
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #09090d;
    color: #f5f5f7;
    font-family: "Inter", sans-serif;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font-family: inherit;
}

.container {
    width: min(1180px, calc(100% - 40px));
    margin: auto;
}


/* =====================================================
   CORES
===================================================== */

:root {

    --background: #09090d;
    --background-2: #0f0f15;

    --card: #12121a;
    --card-hover: #181822;

    --white: #f5f5f7;
    --gray: #9999a8;
    --gray-dark: #646471;

    --purple: #a855f7;
    --purple-light: #c084fc;
    --pink: #ec4899;

    --border: rgba(255,255,255,0.08);

    --gradient:
        linear-gradient(
            135deg,
            #a855f7,
            #ec4899
        );
}


/* =====================================================
   HEADER
===================================================== */

.header {
    position: fixed;
    top: 0;
    left: 0;

    width: 100%;

    z-index: 1000;

    background: rgba(9,9,13,0.75);

    backdrop-filter: blur(20px);

    border-bottom: 1px solid transparent;

    transition: 0.3s;
}

.header.scrolled {
    border-color: var(--border);
}

.nav {
    height: 78px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}


/* LOGO */

.logo {
    font-family: "Space Grotesk", sans-serif;

    font-size: 20px;

    font-weight: 700;

    letter-spacing: -0.5px;
}

.logo span {
    color: var(--purple-light);
}


/* MENU */

.menu {
    display: flex;
    align-items: center;
    gap: 36px;
}

.menu a {
    position: relative;

    color: var(--gray);

    font-size: 14px;

    transition: 0.3s;
}

.menu a:hover,
.menu a.active {
    color: white;
}

.menu a::after {
    content: "";

    position: absolute;

    bottom: -8px;
    left: 0;

    width: 0;
    height: 2px;

    background: var(--gradient);

    transition: 0.3s;
}

.menu a:hover::after,
.menu a.active::after {
    width: 100%;
}


/* MOBILE MENU BUTTON */

.menu-button {
    display: none;

    background: none;
    border: none;

    color: white;

    font-size: 22px;

    cursor: pointer;
}


/* =====================================================
   HERO
===================================================== */

.hero {
    min-height: 100vh;

    position: relative;

    display: flex;
    align-items: center;

    overflow: hidden;

    padding-top: 80px;
}


/* GLOWS */

.hero-glow {
    position: absolute;

    border-radius: 50%;

    filter: blur(100px);

    opacity: 0.15;

    pointer-events: none;
}

.glow-one {
    width: 400px;
    height: 400px;

    background: var(--purple);

    top: 10%;
    left: -200px;
}

.glow-two {
    width: 350px;
    height: 350px;

    background: var(--pink);

    right: -150px;
    bottom: 10%;
}


/* HERO CONTENT */

.hero-content {
    display: grid;

    grid-template-columns: 1.05fr 0.95fr;

    align-items: center;

    gap: 80px;
}


/* TEXT */

.available {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    padding: 8px 13px;

    margin-bottom: 28px;

    border: 1px solid rgba(168,85,247,0.25);

    border-radius: 100px;

    background: rgba(168,85,247,0.07);

    color: #c9a4e8;

    font-size: 12px;
}

.available span {
    width: 7px;
    height: 7px;

    background: #4ade80;

    border-radius: 50%;

    box-shadow: 0 0 12px #4ade80;
}

.small-title {
    color: var(--gray);

    font-size: 17px;

    margin-bottom: 8px;
}

.hero h1 {
    font-family: "Space Grotesk", sans-serif;

    font-size: clamp(60px, 8vw, 105px);

    line-height: 0.95;

    letter-spacing: -5px;

    font-weight: 700;
}

.hero h1 span {
    display: block;

    background: var(--gradient);

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
}

.hero h2 {
    margin-top: 25px;

    font-size: clamp(20px, 2vw, 27px);

    color: #d1d1db;

    font-weight: 500;
}

.hero-description {
    max-width: 560px;

    margin-top: 22px;

    color: var(--gray);

    font-size: 16px;

    line-height: 1.8;
}


/* BUTTONS */

.hero-buttons {
    display: flex;

    gap: 13px;

    margin-top: 32px;

    flex-wrap: wrap;
}

.button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 10px;

    min-height: 48px;

    padding: 0 22px;

    border-radius: 8px;

    font-size: 14px;

    font-weight: 600;

    transition: 0.3s;
}

.button.primary {
    color: white;

    background: var(--gradient);

    box-shadow: 0 12px 35px rgba(168,85,247,0.2);
}

.button.primary:hover {
    transform: translateY(-3px);

    box-shadow: 0 18px 40px rgba(168,85,247,0.3);
}

.button.secondary {
    border: 1px solid var(--border);

    color: #ddd;

    background: rgba(255,255,255,0.025);
}

.button.secondary:hover {
    background: rgba(255,255,255,0.07);
}


/* SOCIAL */

.socials {
    display: flex;

    gap: 10px;

    margin-top: 30px;
}

.socials a {
    width: 40px;
    height: 40px;

    display: grid;
    place-items: center;

    border: 1px solid var(--border);

    border-radius: 50%;

    color: var(--gray);

    transition: 0.3s;
}

.socials a:hover {
    color: white;

    border-color: var(--purple);

    background: rgba(168,85,247,0.1);

    transform: translateY(-3px);
}


/* =====================================================
   FOTO
===================================================== */

.hero-photo {
    position: relative;

    display: flex;

    justify-content: center;

    align-items: center;
}

.photo-frame {
    position: relative;

    width: min(420px, 90vw);
    height: 510px;

    overflow: hidden;

    border-radius: 220px 220px 20px 20px;

    border: 1px solid rgba(255,255,255,0.12);

    background: #171720;

    z-index: 2;
}

.photo-frame::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            180deg,
            transparent 60%,
            rgba(9,9,13,0.55)
        );

    pointer-events: none;
}

.photo-frame img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center 30%;

    filter: saturate(0.95);

    transition: 0.7s;
}

.photo-frame:hover img {
    transform: scale(1.04);
}


/* DECORATION */

.photo-decoration {
    position: absolute;

    width: 420px;
    height: 510px;

    border-radius: 220px 220px 20px 20px;

    border: 1px solid rgba(168,85,247,0.35);

    transform: translate(25px, 25px);

    z-index: 1;
}


/* FLOATING CARD */

.floating-card {
    position: absolute;

    bottom: 35px;
    left: -30px;

    z-index: 5;

    display: flex;

    align-items: center;

    gap: 13px;

    padding: 15px 18px;

    border: 1px solid var(--border);

    border-radius: 12px;

    background: rgba(18,18,26,0.9);

    backdrop-filter: blur(15px);

    box-shadow: 0 20px 50px rgba(0,0,0,0.35);
}

.floating-card > i {
    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background: rgba(168,85,247,0.12);

    color: var(--purple-light);
}

.floating-card div {
    display: flex;

    flex-direction: column;

    gap: 3px;
}

.floating-card strong {
    font-size: 18px;
}

.floating-card span {
    color: var(--gray);

    font-size: 11px;
}


/* SCROLL */

.scroll-indicator {
    position: absolute;

    bottom: 30px;
    left: 50%;

    transform: translateX(-50%);

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 8px;

    color: var(--gray-dark);

    font-size: 9px;

    letter-spacing: 3px;
}

.scroll-indicator i {
    color: var(--gray);
}


/* =====================================================
   SECTIONS
===================================================== */

.section {
    padding: 130px 0;
}

.section-label {
    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 55px;

    color: var(--gray);

    text-transform: uppercase;

    letter-spacing: 2px;

    font-size: 11px;
}

.section-label span {
    color: var(--purple-light);
}


/* =====================================================
   ABOUT
===================================================== */

.about {
    background: var(--background-2);

    border-top: 1px solid var(--border);

    border-bottom: 1px solid var(--border);
}

.about-grid {
    display: grid;

    grid-template-columns: 0.8fr 1.2fr;

    gap: 100px;
}

.about-title h2,
.section-heading h2,
.journey h2 {
    font-family: "Space Grotesk", sans-serif;

    font-size: clamp(38px, 5vw, 60px);

    line-height: 1.05;

    letter-spacing: -2px;
}

.about-title span,
.section-heading span,
.journey h2 span,
.contact h2 span {
    color: var(--purple-light);
}

.about-content {
    color: var(--gray);

    line-height: 1.8;

    font-size: 15px;
}

.about-content p {
    margin-bottom: 22px;
}

.about-content .large-text {
    color: #e5e5ea;

    font-size: 20px;

    line-height: 1.6;
}

.about-info {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 15px;

    margin-top: 40px;

    padding-top: 30px;

    border-top: 1px solid var(--border);
}

.about-info div {
    display: flex;

    flex-direction: column;

    gap: 7px;
}

.about-info span {
    color: var(--gray-dark);

    font-size: 11px;

    text-transform: uppercase;

    letter-spacing: 1px;
}

.about-info strong {
    color: #ddd;

    font-size: 13px;

    font-weight: 500;
}


/* =====================================================
   SKILLS
===================================================== */

.section-heading {
    display: grid;

    grid-template-columns: 1fr 0.65fr;

    gap: 80px;

    align-items: end;

    margin-bottom: 55px;
}

.section-heading p {
    color: var(--gray);

    line-height: 1.7;

    font-size: 15px;
}

.skills-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 1px;

    background: var(--border);

    border: 1px solid var(--border);
}

.skill {
    padding: 35px;

    background: var(--background);

    transition: 0.3s;
}

.skill:hover {
    background: var(--card);
}

.skill-icon {
    width: 50px;
    height: 50px;

    display: grid;
    place-items: center;

    border-radius: 12px;

    margin-bottom: 22px;

    font-size: 23px;
}

.skill-icon.html {
    color: #f97316;
    background: rgba(249,115,22,0.1);
}

.skill-icon.css {
    color: #3b82f6;
    background: rgba(59,130,246,0.1);
}

.skill-icon.javascript {
    color: #facc15;
    background: rgba(250,204,21,0.1);
}

.skill-icon.firebase {
    color: #f59e0b;
    background: rgba(245,158,11,0.1);
}

.skill-icon.git {
    color: #ef4444;
    background: rgba(239,68,68,0.1);
}

.skill-icon.responsive {
    color: #a855f7;
    background: rgba(168,85,247,0.1);
}

.skill h3 {
    font-size: 17px;

    margin-bottom: 10px;
}

.skill p {
    color: var(--gray);

    font-size: 13px;

    line-height: 1.7;
}


/* =====================================================
   PROJECTS
===================================================== */

.projects-section {
    background: var(--background-2);

    border-top: 1px solid var(--border);

    border-bottom: 1px solid var(--border);
}

.projects-heading {
    margin-bottom: 70px;
}

.projects-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 25px;
}

.project {
    border: 1px solid var(--border);

    background: var(--background);

    overflow: hidden;

    transition: 0.4s;
}

.project:hover {
    transform: translateY(-7px);

    border-color: rgba(168,85,247,0.35);
}


/* PROJECT IMAGE */

.project-image {
    height: 300px;

    position: relative;

    overflow: hidden;

    display: flex;

    align-items: center;

    justify-content: center;
}

.calculator {
    background:
        radial-gradient(
            circle at center,
            rgba(168,85,247,0.35),
            transparent 50%
        ),
        #11101a;
}

.barber {
    background:
        radial-gradient(
            circle at center,
            rgba(236,72,153,0.3),
            transparent 50%
        ),
        #151013;
}

.database {
    background:
        radial-gradient(
            circle at center,
            rgba(59,130,246,0.3),
            transparent 50%
        ),
        #0e1218;
}

.browser-bar {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;

    height: 35px;

    display: flex;

    align-items: center;

    gap: 6px;

    padding-left: 15px;

    background: rgba(0,0,0,0.2);

    border-bottom: 1px solid rgba(255,255,255,0.05);
}

.browser-bar span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: rgba(255,255,255,0.2);
}

.mockup-content {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 12px;
}

.mockup-content i {
    font-size: 60px;

    color: rgba(255,255,255,0.9);

    filter: drop-shadow(0 10px 25px rgba(0,0,0,0.4));
}

.mockup-content strong {
    font-family: "Space Grotesk", sans-serif;

    font-size: 24px;
}

.mockup-content small {
    color: var(--gray);

    font-size: 12px;
}


/* PROJECT INFO */

.project-info {
    padding: 28px;
}

.project-top {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 18px;
}

.project-top > span {
    color: var(--purple-light);

    font-size: 12px;
}

.project-tech {
    color: var(--gray-dark);

    font-size: 11px;
}

.project h3 {
    font-family: "Space Grotesk", sans-serif;

    font-size: 23px;

    margin-bottom: 12px;
}

.project-info p {
    color: var(--gray);

    font-size: 14px;

    line-height: 1.7;

    max-width: 550px;
}

.project-link {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    margin-top: 25px;

    color: #ddd;

    font-size: 13px;

    font-weight: 600;

    transition: 0.3s;
}

.project-link:hover {
    color: var(--purple-light);

    gap: 13px;
}


/* =====================================================
   JOURNEY
===================================================== */

.journey-grid {
    display: grid;

    grid-template-columns: 0.8fr 1.2fr;

    gap: 100px;
}

.timeline {
    border-left: 1px solid var(--border);
}

.timeline-item {
    position: relative;

    display: grid;

    grid-template-columns: 80px 1fr;

    gap: 25px;

    padding: 0 0 50px 30px;
}

.timeline-item:last-child {
    padding-bottom: 0;
}

.timeline-item::before {
    content: "";

    position: absolute;

    left: -4px;
    top: 4px;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--purple);

    box-shadow: 0 0 15px var(--purple);
}

.timeline-year {
    color: var(--purple-light);

    font-size: 12px;

    font-weight: 600;
}

.timeline-item h3 {
    margin-bottom: 10px;

    font-size: 18px;
}

.timeline-item p {
    color: var(--gray);

    font-size: 14px;

    line-height: 1.7;
}


/* =====================================================
   CONTACT
===================================================== */

.contact {
    position: relative;

    padding: 150px 0;

    text-align: center;

    overflow: hidden;

    border-top: 1px solid var(--border);
}

.contact-glow {
    position: absolute;

    width: 500px;
    height: 500px;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background: var(--purple);

    filter: blur(150px);

    opacity: 0.08;
}

.contact-content {
    position: relative;

    z-index: 2;
}

.contact .section-label {
    justify-content: center;
}

.contact h2 {
    font-family: "Space Grotesk", sans-serif;

    font-size: clamp(45px, 7vw, 80px);

    letter-spacing: -3px;

    line-height: 1;
}

.contact p {
    max-width: 550px;

    margin: 25px auto 0;

    color: var(--gray);

    line-height: 1.7;
}

.contact-buttons {
    display: flex;

    justify-content: center;

    gap: 12px;

    margin-top: 35px;

    flex-wrap: wrap;
}

.button.whatsapp {
    border: 1px solid rgba(34,197,94,0.25);

    color: #4ade80;

    background: rgba(34,197,94,0.06);
}


/* =====================================================
   FOOTER
===================================================== */

footer {
    border-top: 1px solid var(--border);

    padding: 30px 0;

    background: #07070a;
}

.footer-content {
    display: flex;

    align-items: center;

    justify-content: space-between;
}

.footer-content p {
    color: var(--gray-dark);

    font-size: 11px;
}

.footer-socials {
    display: flex;

    gap: 12px;
}

.footer-socials a {
    color: var(--gray-dark);

    font-size: 15px;

    transition: 0.3s;
}

.footer-socials a:hover {
    color: white;
}


/* =====================================================
   RESPONSIVIDADE
===================================================== */

@media (max-width: 900px) {

    .menu {
        position: absolute;

        top: 78px;
        right: 20px;

        width: 220px;

        padding: 20px;

        display: none;

        flex-direction: column;

        align-items: flex-start;

        gap: 20px;

        background: #12121a;

        border: 1px solid var(--border);

        border-radius: 12px;

        box-shadow: 0 20px 50px rgba(0,0,0,0.4);
    }

    .menu.open {
        display: flex;
    }

    .menu-button {
        display: block;
    }

    .hero-content {
        grid-template-columns: 1fr;

        gap: 70px;

        padding-top: 50px;

        text-align: center;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons,
    .socials {
        justify-content: center;
    }

    .hero-photo {
        order: -1;
    }

    .photo-frame {
        width: 300px;
        height: 370px;
    }

    .photo-decoration {
        width: 300px;
        height: 370px;
    }

    .floating-card {
        left: 0;
    }

    .scroll-indicator {
        display: none;
    }

    .about-grid,
    .journey-grid {
        grid-template-columns: 1fr;

        gap: 50px;
    }

    .section-heading {
        grid-template-columns: 1fr;

        gap: 20px;
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}


@media (max-width: 650px) {

    .container {
        width: min(100% - 30px, 1180px);
    }

    .section {
        padding: 90px 0;
    }

    .hero h1 {
        font-size: 65px;

        letter-spacing: -3px;
    }

    .hero h2 {
        font-size: 20px;
    }

    .photo-frame {
        width: 260px;
        height: 330px;
    }

    .photo-decoration {
        width: 260px;
        height: 330px;
    }

    .floating-card {
        bottom: 15px;
        left: 0;

        padding: 10px 13px;
    }

    .about-info {
        grid-template-columns: 1fr;
    }

    .skills-grid {
        grid-template-columns: 1fr;
    }

    .projects-grid {
        grid-template-columns: 1fr;
    }

    .project-image {
        height: 250px;
    }

    .timeline-item {
        grid-template-columns: 1fr;

        gap: 8px;
    }

    .footer-content {
        flex-direction: column;

        gap: 20px;
    }

}
.reveal {
    opacity: 0;

    transform: translateY(25px);

    transition:
        opacity 0.7s ease,
        transform 0.7s ease;
}

.reveal.visible {
    opacity: 1;

    transform: translateY(0);
}
